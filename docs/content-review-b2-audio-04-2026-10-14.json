  "corrections": [
    {
      "id": "t-b2-36",
      "notes": "دُقّق النقاش حول بدء اليوم الدراسي لاحقاً؛ فُصلت الحجج المؤيدة (النوم والإرهاق) عن اعتراضات التنظيم والنقل والرعاية. صيغت آثار التحصيل بوصفها أمراً ينبغي قياسه، وانتهى النص بتجربة محلية ترصد النوم والرفاه والمشاركة لا العلامات وحدها.",
      "arabic": "ترجمة كاملة من ثلاث فقرات؛ نقل 8→9 مثال قابل للاختبار لا قاعدة عامة."
    },
    {
      "id": "t-b2-37",
      "notes": "وُسم الراوي صراحةً بأنه خيالي، وحُصرت ملاحظته في خبرة شخصية لتجنب تعميمات عن جميع الألمان أو الثقافات. حُفظ التوازن بين سوء الفهم الأولي والتعلم من السؤال والتوضيح.",
      "arabic": "ترجمة كاملة؛ حُفظت «المباشرة» في الأمثلة والتمييز بين رأي الراوي والحكم على مجتمع كامل."
    },
    {
      "id": "t-b2-38",
      "notes": "أُعيد تحرير النص الطويل إلى 180 كلمة، وصُحح wordCountDe القديم (205 رغم أن النص السابق بلغ 269 كلمة بحسب split whitespace). فُصلت نتائج آيسلندا والمملكة المتحدة وألمانيا، وقُيّدت نتيجة 1.4% بمجموعة 23/61 وبالوزن الحجمي، ونُفي الاستدلال السببي. ذُكر أن تجربة ألمانيا سجّلت تحسناً مُبلّغاً عنه وأن تراجع أيام المرض لم يكن ذا دلالة إحصائية.",
      "arabic": "ترجمة كاملة؛ حُفظت أعداد المؤسسات ومقام عينة الإيرادات وحدود الدلالة الإحصائية."
    },
    {
      "id": "t-b2-39",
      "notes": "ضُبطت جملة ندرة الخدمات لتكون سليمة نحوياً، وأُبقيت القيود بصيغ احتمالية حسب المنطقة. لا يتضمن النص نسباً أو أرقاماً محلية غير موثقة؛ كما يضم النقل والإنترنت ورعاية الأطفال والخدمات العامة ضمن قرار الانتقال. أضاف التدقيق الختامي جملة توصية بالمراجعة المنتظمة لبلوغ حد B2 الأدنى البالغ 173 كلمة؛ أُعيد تسجيل t-b2-39 بعد ذلك.",
      "arabic": "ترجمة كاملة تفصل بين أسباب الانتقال ومخاطره وشروط البنية التحتية. وأضيفت ترجمة «وينبغي تقييم هذه الحلول بانتظام»."
    },
    {
      "id": "t-b2-40",
      "notes": "مُيّزت دوافع حماية الذات ومراعاة الآخرين وتحسين الصورة عن التلاعب المتعمد؛ صيغ أثر كذبة المجاملة بصيغة احتمالية، وأضيف توازن بين الصدق ومراعاة المخاطَب.",
      "arabic": "ترجمة كاملة؛ لم تُحوّل الملاحظات الأخلاقية إلى ادعاءات نفسية تجريبية."
    }
  ],
  "factualReview": {
    "t-b2-36": "استندت المراجعة إلى بيان AASM عن تأخر الإيقاع اليومي للمراهقين وآثار بدء المدرسة المبكر، وإلى موقفها الذي يدعو إلى 8:30 صباحاً أو بعده للمرحلتين المتوسطة والثانوية. نقل 8→9 في النص مثالٌ افتراضي لتجربة، لا توصية عامة؛ الأثر في الدرجات مقترحٌ للقياس لا حقيقة مفترضة.",
    "t-b2-37": "الراوي والقصة خياليان ومصرّح بذلك داخل النص والعنوان. لا يُعرض أسلوب تواصل شخص واحد بوصفه سمةً ثابتة لجميع الألمان أو لأبناء ثقافة أخرى.",
    "t-b2-38": "قورنت الأرقام بتقارير Alda/Autonomy وUKRI/ESRC وجامعة Münster: تجربة بريطانيا 61 منظمة، ولم تقدم الإيرادات إلا 23 منظمة؛ المتوسط المرجّح بحجم المنظمة +1.4%. في ألمانيا شاركت 45 منظمة، وكان انخفاض أيام المرض طفيفاً وغير دال إحصائياً. اختلاف التصاميم وقيود البيانات تعني أن النتيجة ليست علاقة سببية ولا تبرر تعميماً على كل القطاعات.",
    "t-b2-39": "النص عام وغير مربوط بدولة بعينها؛ استُخدمت «بحسب المنطقة» و«قد» و«يمكن»، بلا أرقام محلية. البنية التحتية وحاجات السكان توصية سياسية/عملية لا إحصاء يدّعي الانتشار.",
    "t-b2-40": "النص يعرض فروقاً مفهومية وأمثلة يومية بصياغة معيارية، لا نتائج تجربة أو تشخيصاً نفسياً. فُصلت اللباقة عن الخداع المتعمد، وقُيّد الضرر المحتمل بظهور الحقيقة لاحقاً."
  },
  "sources": [
    {
      "title": "School Start Times / Delaying Middle School and High School Start Times Promotes Student Health and Performance",
      "publisher": "American Academy of Sleep Medicine (AASM)",
      "url": "https://aasm.org/advocacy/initiatives/school-start-times/",
      "supports": "يشرح تغير الإيقاع اليومي لدى المراهقين وصلة النوم باليقظة والصحة؛ موقف الجمعية يوصي ببدء المرحلة المتوسطة والثانوية 8:30 صباحاً أو بعده."
    },
    {
      "title": "Going Public: Iceland's Journey to a Shorter Working Week",
