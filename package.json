{
  "name": "weg-nach-b2",
  "version": "1.0.0",
  "private": true,
  "description": "طريقي إلى B2 — مسار تعلّم محلي للألمانية من A0 نحو B2",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "interaktiv": "esbuild scripts/interaktiv_test.tsx --bundle --platform=node --format=cjs --external:jsdom --jsx=automatic --outfile=node_modules/.cache/interaktiv.cjs --log-level=error && node node_modules/.cache/interaktiv.cjs",
    "smoke": "esbuild scripts/engine_smoke.ts --bundle --platform=node --format=cjs --jsx=transform --tsconfig=tsconfig.json --outfile=.cache/smoke.cjs --log-level=warning && node .cache/smoke.cjs",
    "audit:content": "esbuild scripts/audit_inhalt.ts --bundle --platform=node --format=cjs --tsconfig=tsconfig.json --outfile=.cache/audit.cjs --log-level=warning && node .cache/audit.cjs",
    "audit:vocab-posinfo": "tsx scripts/vocab_posinfo_audit.ts",
    "audit:writing-consistency": "tsx scripts/writing_consistency_audit.ts",
    "audit:learning-state": "tsx scripts/learning_state_audit.ts",
    "audit:assessment-integrity": "tsx scripts/assessment_integrity_audit.ts",
    "audit:evidence-provenance": "tsx scripts/evidence_provenance_audit.ts",
    "audit:time-model": "tsx scripts/time_model_audit.ts",
    "audit:mediation": "tsx scripts/mediation_audit.ts",
    "audit:language-fields": "tsx scripts/language_direction_audit.ts",
    "audit:placement": "tsx scripts/placement_audit.ts",
    "audit:competency-evidence": "tsx scripts/competency_evidence_audit.ts",
    "audit:simulation-provenance": "tsx scripts/simulation_provenance_audit.ts",
    "audit:lexical-inventory": "tsx scripts/lexical_inventory_audit.ts",
    "audit:personalization": "tsx scripts/personalization_audit.ts",
    "audit:cando-integrity": "tsx scripts/cando_integrity_audit.ts",
    "audit:words": "tsx scripts/wort_fuer_wort_audit.ts",
    "audit:scaffolds": "tsx scripts/scaffold_audit.ts",
    "audit:scaffold-review": "tsx scripts/scaffold_review_audit.ts",
    "audit:repo": "python3 scripts/repo_audit.py",
    "audit:plan": "tsx scripts/student_audit.ts",
    "audit:accreditation": "tsx scripts/accreditation_audit.ts",
    "audit:accreditation:strict": "tsx scripts/accreditation_audit.ts --strict-official",
    "gen:ggp": "node scripts/gen_grammar_profile.mjs",
    "audit:ggp": "tsx scripts/grammar_profile_audit.ts",
    "audit:ggp:strict": "tsx scripts/grammar_profile_audit.ts --strict-external",
    "audit:tools": "tsx scripts/tool_catalog_audit.ts",
    "audit:tools:strict": "tsx scripts/tool_catalog_audit.ts --strict-production",
    "audit:evidence": "tsx scripts/external_evidence_audit.ts",
    "audit:evidence:strict": "tsx scripts/external_evidence_audit.ts --strict-evidence",
    "evidence:hash": "node scripts/evidence_hash.mjs",
    "audit:real-world": "tsx scripts/real_world_audit.ts",
    "audit:real-world:strict": "tsx scripts/real_world_audit.ts --strict-field",
    "audit:lighthouse": "lhci autorun",
    "e2e:browser": "node scripts/browser_e2e.mjs",
    "gen:tools": "node scripts/gen_tools.mjs",
    "extract:tools": "node scripts/extract_tools.mjs",
    "build": "next build",
    "start": "next start",
    "banken": "node scripts/copy_banks.mjs",
    "prebuild": "npm run banken",
    "predev": "npm run banken",
    "audio:qc": "python3 scripts/run_audio_qc.py",
    "lint": "eslint app components lib scripts middleware.ts",
    "audit:deps": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "@next/eslint-plugin-next": "15.5.29",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "31.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    },
    "basic-ftp": "6.2.6"
  }
}
