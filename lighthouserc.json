{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run build && npm run start -- -p 3000",
      "url": ["http://localhost:3000/", "http://localhost:3000/lernen", "http://localhost:3000/ueben"]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.7}],
        "categories:accessibility": ["error", {"minScore": 0.9}],
        "categories:best-practices": ["warn", {"minScore": 0.8}]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
